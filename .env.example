# ==============================================================================
# ObraFlow - Configurações de Ambiente (Local / Staging / Production)
# ==============================================================================

# 1. Banco de Dados Relacional Serverless (Neon DB)
# Conexão Pooled recomendada para Vercel Serverless Functions:
DATABASE_URL="postgres://usuario:senha@ep-pooler.neon.tech/neondb?sslmode=require"

# Conexão direta e exclusiva para aplicar migrations (nunca usar no runtime).
# Preferida por npm run db:migrate em produção.
MIGRATION_DATABASE_URL=""

# Escrita de dados sintéticos somente em ambiente não produtivo. Os scripts
# também exigem ALLOW_DEMO_SEED=true; não reutilize credenciais de runtime.
SEED_DATABASE_URL=""
ALLOW_DEMO_SEED="false"

# Token aleatório, server-side, usado somente pelo readiness check protegido.
# Não reutilize tokens do Thirdweb, Neon ou de outro ambiente.
HEALTHCHECK_TOKEN=""

# Conexão Direta (fallback compatível para migrations locais):
# DATABASE_URL_UNPOOLED="postgres://usuario:senha@ep-direct.neon.tech/neondb?sslmode=require"

# 2. Driver de Persistência do Servidor Local
# Opções: "json" (usa ./mock_data/*.json) | "postgres" (usa Neon DB via DATABASE_URL)
STORAGE_DRIVER="json"

# 3. Porta do Servidor Local Transacional
MOCK_PORT=3001

# 4. Google Gemini API Key (Opcional - Motor Heurístico funciona 100% offline se omitido)
GEMINI_API_KEY=""

# 5. Vercel Blob Storage Token (Para produção na nuvem)
# BLOB_READ_WRITE_TOKEN=""
