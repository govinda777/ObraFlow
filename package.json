{
  "name": "obraflow-reports",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sources": "evidence sources",
    "dev": "node scripts/dev-local.js",
    "dev:web": "next dev",
    "dev:ui": "evidence dev",
    "mock-server": "node scripts/mock-data-server.js",
    "build": "evidence build",
    "build:web": "next build",
    "preview": "evidence preview",
    "start:web": "next start",
    "typecheck:web": "next typegen && tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:bdd": "cucumber-js --config cucumber.mjs",
    "test:health": "node --test tests/unit/health.test.js && cucumber-js --config cucumber.mjs --tags @health",
    "test:health:routes": "node --test tests/integration/health-routes.test.js",
    "test:db": "node --test tests/integration/database-security.test.js tests/integration/demo-seed.test.js",
    "test:iac": "tofu -chdir=infra/terraform/neon test && tofu -chdir=infra/terraform/vercel test",
    "test:web": "npm run typecheck:web && npm run test:unit && npm run test:db && npm run test:bdd && npm run build:web && npm run test:health:routes",
    "infra:plan": "node scripts/tofu-infra.cjs plan both staging",
    "infra:up": "node scripts/tofu-infra.cjs apply both staging",
    "infra:down": "node scripts/tofu-infra.cjs destroy both staging",
    "infra:plan:prod": "node scripts/tofu-infra.cjs plan both production",
    "infra:up:prod": "node scripts/tofu-infra.cjs apply both production",
    "infra:down:prod": "node scripts/tofu-infra.cjs destroy both production",
    "infra:plan:neon": "node scripts/tofu-infra.cjs plan neon staging",
    "infra:up:neon": "node scripts/tofu-infra.cjs apply neon staging",
    "infra:down:neon": "node scripts/tofu-infra.cjs destroy neon staging",
    "infra:plan:vercel": "node scripts/tofu-infra.cjs plan vercel staging",
    "infra:up:vercel": "node scripts/tofu-infra.cjs apply vercel staging",
    "infra:down:vercel": "node scripts/tofu-infra.cjs destroy vercel staging",
    "db:migrate": "node scripts/db/migrate.js",
    "db:migrate:dry-run": "node scripts/db/migrate.js --dry-run",
    "db:seed": "node scripts/db/seed-demo.js",
    "db:seed:clean": "node scripts/db/seed-clean.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@evidence-dev/core-components": "^5.4.2",
    "@evidence-dev/duckdb": "^2.0.1",
    "@evidence-dev/evidence": "^40.1.8",
    "@neondatabase/serverless": "^1.2.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "ai": "^7.0.173",
    "autoprefixer": "^10.6.2",
    "debounce": "^4.0.0",
    "dotenv": "^18.0.9",
    "git-remote-origin-url": "^4.0.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "postcss-load-config": "^6.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^4.2.19",
    "svelte-preprocess": "^6.0.5",
    "svelte2tsx": "^0.7.63",
    "tailwindcss": "^3.4.17",
    "thirdweb": "^5.122.1",
    "typescript": "5.4.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^5.4.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@electric-sql/pglite": "0.5.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
